:root{
  --green:#0f5f35;
  --green-dark:#093f24;
  --green-mid:#2e7d4f;
  --green-light:#edf7f0;
  --green-pale:#f7fbf8;
  --ink:#152019;
  --muted:#66756b;
  --line:#cfe1d4;
  --white:#fff;
  --shadow:0 16px 42px rgba(9,63,36,.10);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#f3f7f4;color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.5}
a{color:inherit}.wrap{width:min(1180px,calc(100% - 36px));margin:0 auto}.skip-link{position:absolute;left:-999px;top:10px;background:#fff;padding:10px 14px;z-index:100}.skip-link:focus{left:10px}

.site-header{position:sticky;top:0;z-index:30;background:linear-gradient(90deg,#0a4828,#0f5f35 55%,#155e38);color:#fff;box-shadow:0 4px 18px rgba(9,63,36,.18)}
.nav-wrap{min-height:82px;display:grid;grid-template-columns:auto auto 1fr auto;align-items:center;gap:22px}.home-link{font-weight:900;font-size:21px;text-decoration:none;padding-right:22px;border-right:2px solid rgba(255,255,255,.78)}.brand-block{display:flex;flex-direction:column;line-height:1.06}.brand-block strong{font-size:29px;letter-spacing:-.03em}.brand-block span{font-size:13px;font-style:italic;opacity:.9;margin-top:4px}.site-header nav{display:flex;justify-content:flex-end;gap:28px}.site-header nav a{font-size:16px;font-weight:800;text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}.site-header nav a:hover{color:#d8f0df}.header-emblem{width:132px;height:58px;object-fit:contain;display:block}

.daily-trivia-section{padding:26px 0 18px;background:linear-gradient(180deg,#e6f3ea,#f3f7f4)}.trivia-card{display:grid;grid-template-columns:300px 1fr;gap:34px;align-items:center;background:linear-gradient(120deg,#fbfefc,#eef8f1);border:1px solid #b9d5c1;border-radius:24px;padding:18px 30px;box-shadow:var(--shadow);min-height:300px}.mascot-column{height:100%;display:flex;align-items:center;justify-content:center;border-right:2px solid #86b495;padding-right:24px}.eala-saurus{width:250px;height:250px;object-fit:contain}.daily-trivia-copy h1{margin:0 0 16px;color:var(--green-dark);font-size:clamp(34px,4vw,55px);line-height:1.02;letter-spacing:-.04em}.daily-trivia-question{margin:0 0 22px;color:#121712;font-size:clamp(24px,2.7vw,38px);line-height:1.22}.daily-trivia-reveal{border:0;border-radius:14px;background:var(--green-mid);color:#fff;padding:13px 27px;font:inherit;font-size:26px;font-weight:900;cursor:pointer;box-shadow:0 8px 18px rgba(15,95,53,.16)}.daily-trivia-reveal:hover,.daily-trivia-reveal:focus-visible{background:var(--green-dark)}.daily-trivia-reveal.is-revealed,.daily-trivia-reveal.is-revealed:disabled{background:transparent;color:var(--green-dark);box-shadow:none;padding-left:0;cursor:default}

.dashboard-section{padding:14px 0 34px}.dashboard-grid{display:grid;grid-template-columns:.95fr 1.45fr .9fr;gap:18px;align-items:start}.panel{background:#fff;border:1px solid #bcd5c3;border-radius:18px;overflow:hidden;box-shadow:0 8px 24px rgba(9,63,36,.06)}.panel-heading{min-height:64px;display:flex;align-items:center;justify-content:space-between;padding:16px 20px;background:linear-gradient(180deg,#f7fbf8,#e8f4ec);border-bottom:1px solid var(--line)}.panel-heading h2{margin:0;color:var(--green-dark);font-size:25px;line-height:1.1;letter-spacing:-.025em}.panel-body{padding:14px 20px 20px}
.simple-link-list{display:flex;flex-direction:column}.simple-link-list a,.simple-link-label{padding:10px 0;border-bottom:1px solid #e2ece5;font-size:17px;line-height:1.25;font-weight:800}.simple-link-list a{color:#164f2f;text-decoration:underline;text-underline-offset:4px}.simple-link-list a:hover{color:#0a7a3f}.simple-link-label{color:var(--muted);font-size:14px;padding-top:15px}.resource-links a.result-level{padding-left:18px}.social-link-list a{font-size:17px}
.news-heading .refresh{width:34px;height:34px;border:1px solid #aacdb4;border-radius:50%;background:#fff;color:var(--green-dark);font-size:20px;font-weight:900;cursor:pointer}.news-body{padding-top:10px}.feed-meta{margin:0 0 8px;color:var(--muted);font-size:11px}.news-grid{display:grid;grid-template-columns:1fr}.news-card{display:block;padding:14px 0;border-bottom:1px solid #dce9df;text-decoration:none}.news-card:last-child{border-bottom:0}.news-card .source{display:block;color:var(--green-mid);font-size:10px;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.news-card h3{margin:5px 0 7px;color:#144f2f;font-size:18px;line-height:1.22;text-decoration:underline;text-underline-offset:3px}.news-card:hover h3{color:#08763c}.card-footer{display:flex;justify-content:space-between;color:#7a877f;font-size:11px}.arrow{color:var(--green-mid);font-weight:900}.skeleton{height:76px;margin:8px 0;border-radius:10px;background:linear-gradient(90deg,#eef4f0 25%,#f8fbf9 37%,#eef4f0 63%);background-size:400% 100%;animation:shimmer 1.4s ease infinite}@keyframes shimmer{0%{background-position:100% 0}100%{background-position:-100% 0}}
.feed-fallback{padding:10px 0}.feed-fallback h3{margin:0 0 6px}.feed-fallback p{color:var(--muted)}.button.primary{display:inline-block;border-radius:10px;background:var(--green-mid);color:#fff;padding:10px 14px;text-decoration:none;font-weight:900}

.about-section{padding:34px 0 48px;background:#fff;border-top:1px solid var(--line)}.about-grid{display:grid;grid-template-columns:.8fr 1.4fr;gap:40px}.about-grid h2{margin:0;color:var(--green-dark);font-size:27px}.about-copy p{margin:0 0 12px;color:#526158}.about-copy p:last-child{margin-bottom:0}
footer{background:var(--green-dark);color:#fff;padding:24px 0;border-top:4px solid #5e9d70}.footer-grid{display:flex;align-items:center;justify-content:space-between;gap:20px}.footer-grid p{margin:4px 0;color:#d9ebdf}.footer-grid a{color:#fff;text-decoration:underline;text-underline-offset:3px}.noscript{padding:14px;text-align:center;background:#fff3cd}
#resources,#news,#social,#about,#trivia{scroll-margin-top:96px}

@media(max-width:1020px){.nav-wrap{grid-template-columns:auto auto 1fr}.header-emblem{display:none}.site-header nav{gap:18px}.dashboard-grid{grid-template-columns:1fr 1.45fr}.social-panel{grid-column:1/-1}.social-panel .simple-link-list{display:grid;grid-template-columns:1fr 1fr;column-gap:24px}.trivia-card{grid-template-columns:230px 1fr}.eala-saurus{width:205px;height:205px}}
@media(max-width:760px){.nav-wrap{display:flex;min-height:74px;gap:12px;overflow:hidden}.home-link{font-size:16px;padding-right:12px}.brand-block{display:none}.site-header nav{overflow-x:auto;white-space:nowrap;gap:14px;scrollbar-width:none}.site-header nav::-webkit-scrollbar{display:none}.site-header nav a{font-size:13px;flex:0 0 auto}.trivia-card{grid-template-columns:1fr;gap:14px;text-align:left;padding:20px}.mascot-column{border-right:0;border-bottom:2px solid #86b495;padding:0 0 14px}.eala-saurus{width:150px;height:150px}.daily-trivia-copy h1{font-size:32px}.daily-trivia-question{font-size:22px}.daily-trivia-reveal{font-size:22px}.dashboard-grid{grid-template-columns:1fr}.social-panel{grid-column:auto}.social-panel .simple-link-list{display:flex}.about-grid{grid-template-columns:1fr}.footer-grid{flex-direction:column;align-items:flex-start}}
